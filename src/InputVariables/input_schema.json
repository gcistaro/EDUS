{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "tb_file": {
            "type": "string",
            "default": "",
            "title": "name of the file _tb.dat"
        },
        "decay": {
            "type": "number",
            "default": 0.0,
            "title": "decay rate of the density matrix"
        },
        "decay_units": {
            "type": "string",
            "default": "femtoseconds",
            "enum": [
                "femtoseconds",
                "fs",
                "autime"
            ],
            "title": "Units used for the decay rate of the density matrix"
        },
        "fermienergy": {
            "type": "number",
            "default": 0.0,
            "title": "Fermi energy of the system"
        },
        "fermienergy_units": {
            "type": "string",
            "default": "electronvolt",
            "enum": [
                "electronvolt",
                "joule",
                "Rydberg",
                "auenergy"
            ],
            "title": "Units used for the Fermi energy of the system"
        },
        "coulomb": {
            "type": "boolean",
            "default": false,
            "title": "If true, we go beyond IPA using either RPA or HSEX."
        },
        "method": {
            "type": "string",
            "default": "hsex",
            "enum": ["ipa", "rpa", "hsex"],
            "title": "If ipa, non-interactiong particles are considered. If RPA, we consider only the Hartree term for the interaction. If hsex, both Hartree and screened Fock are taken into account."
        },
        "opengap": {
            "type": "number",
            "default": 0,
            "title": "Gap value, if we want to open more gap"
        },
        "opengap_units": {
            "type": "string",
            "default": "electronvolt",
            "enum": [
                "electronvolt",
                "joule",
                "Rydberg",
                "auenergy"
            ],
            "title": "Units used for the gap we want to open"
        },
        "read_interaction": {
            "type": "boolean",
            "default": false,
            "title": "If true, electron-electron interactions are read from barecoulomb.txt and screencoulomb.txt."
        },
        "bare_file": {
            "type": "string",
            "default": "./barecoulomb.txt",
            "title": "Path of the bare Coulomb interaction"
        },
        "screen_file": {
            "type": "string",
            "default": "./screencoulomb.txt",
            "title": "Path of the screened Coulomb interaction"
        },
        "epsilon": {
            "type": "number",
            "default": 1.0,
            "title": "Dielectric constant for RK potential"
        },
        "r0": {
            "type": "array",
            "default": [10.0],
            "title": "r0 screening length for RK potential"
        },
        "r0_units": {
            "type": "string",
            "default": "angstrom",
            "enum": [
                "angstrom",
                "nanometers",
                "nm",
                "aulength"
            ],
            "title": "Units for the Time resolution used for propagating Density Matrix"
        },
        "coulomb_model": {
            "type": "string",
            "default": "rytova_keldysh",
            "enum": [
                "rytova_keldysh",
                "vcoul3d"
            ],
            "title": "Coulomb model type"
        },
        "grid": {
            "type": "array",
            "items": {
                "type": "integer"
            },
            "minItems": 3,
            "maxItems": 3,
            "default": [
                10,
                10,
                1
            ],
            "title": "Dimension of the k grid (R as well) used for the simulation"
        },
        "filledbands": {
            "type": "integer",
            "default": 0,
            "title": "Number of filled bands for the simulation (ideally will be either this of fermienergy"
        },
        "dt": {
            "type": "number",
            "default": 0.01,
            "title": "Time resolution used for propagating Density Matrix"
        },
        "gradient_space": {
            "type": "string",
            "default": "R",
            "title": "Space where the gradient with respect to k is evaluated"
        },
        "dt_units": {
            "type": "string",
            "default": "autime",
            "enum": [
                "femtoseconds",
                "fs",
                "autime"
            ],
            "title": "Units for the Time resolution used for propagating Density Matrix"
        },
        "printresolution": {
            "type": "integer",
            "default": 1,
            "title": "Time steps needed to print in hdf5 and observables"
        },
        "printresolution_pulse": {
            "type": "integer",
            "default": 0,
            "title": "Time steps needed to print in hdf5 and observables during the pulse"
        },
        "initialtime": {
            "type": "number",
            "default": 0.0,
            "title": "Initial time of the simulation"
        },
        "initialtime_units": {
            "type": "string",
            "default": "autime",
            "enum": [
                "femtoseconds",
                "fs",
                "autime"
            ],
            "title": "Units for the Time resolution used for Initial time of the simulation"
        },
        "finaltime": {
            "type": "number",
            "default": 0.0,
            "title": "Final time of the simulation"
        },
        "finaltime_units": {
            "type": "string",
            "default": "autime",
            "enum": [
                "femtoseconds",
                "fs",
                "autime"
            ],
            "title": "Units for the Time resolution used for Final time of the simulation"
        },
        "solver": {
            "type": "string",
            "default": "RK",
            "enum": [
                "RK",
                "AB", "Magnus"],
            "title": "Solver used for time propagation of the Density Matrix"
        },
        "order": {
            "type": "integer",
            "default": 4,
            "title": "Order of the Solver used for time propagation of the Density Matrix: 4 for RK, 3 or 4 for AB, 4 for Magnus"
        },
        "peierls": {
            "type": "boolean",
            "default": true,
            "title": "If true, we propagate the EOM in the Peierls gauge"
        },
        "toprint": {
            "type":  "array",
            "title": "Big quantities that we want to print",
            "minItems": 1,
            "maxItems": 10,
            "default": {
                "DMk_wannier" : "false",
                "DMk_bloch"   : "false",
                "fullH"       : "false",
                "SelfEnergy"  : "false"
            },
            "items" : {
                "DMk_wannier" : {
                    "type"    : "string",
                    "default" : "false",
                    "title"   : "true if you want to print DM in k, wannier gauge"
                },
                "DMk_bloch"   : {
                    "type"    : "string",
                    "default" : "false",
                    "title"   : "true if you want to print DM in k, bloch gauge"
                },
                "fullH"       : {
                    "type"    : "string",
                    "default" : "false",
                    "title"   : "true if you want to print H=H0+Er in k, wannier gauge"
                },
                "SelfEnergy"  : {
                    "type"    : "string",
                    "default" : "false",
                    "title"   : "true if you want to print the self energy in k, wannier gauge"
                }
            }
        },
        "phonons": {
            "type": "object",
            "title": "Lattice coupled to the electrons at the mean-field (Ehrenfest) level, from the Wannier representation of EPW (see src/Phonons/EHRENFEST.md)",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "default": false,
                    "title": "If true, the lattice at q = Gamma is propagated together with the electrons"
                },
                "epw_directory": {
                    "type": "string",
                    "default": "./epw",
                    "title": "Directory of the EPW calculation (epwwrite = .true.) of the bare coupling g_b, with epwdata.fmt, wigner.fmt, crystal.fmt and prefix.epmatwp. The Wannier functions must be the ones of tb_file. g_b gives the force on the atoms, and it is the coupling felt by the electrons if epw_directory_screened is empty"
                },
                "epmatwp": {
                    "type": "string",
                    "default": "",
                    "title": "Name of the file prefix.epmatwp in epw_directory; if empty, the only *.epmatwp file of the directory"
                },
                "epw_directory_screened": {
                    "type": "string",
                    "default": "",
                    "title": "Directory of the EPW calculation of the screened coupling g_s (optional, same Wannier functions). If given, the electrons feel u.g_s and the mean field of rho - rho_BO (the static screening is already in g_s); if empty, they feel u.g_b and the mean field of rho - rho0"
                },
                "epmatwp_screened": {
                    "type": "string",
                    "default": "",
                    "title": "Name of the file prefix.epmatwp in epw_directory_screened; if empty, the only *.epmatwp file of the directory"
                },
                "dyn_file": {
                    "type": "string",
                    "default": "",
                    "title": "Dynamical matrix of ph.x at Gamma (text format, e.g. prefix.dyn1): masses and force constants"
                },
                "qpoints": {
                    "type": "array",
                    "default": [[0.0, 0.0, 0.0]],
                    "title": "Phonon wavevectors in crystal coordinates. Only Gamma is implemented"
                },
                "spin_degeneracy": {
                    "type": "number",
                    "default": 2.0,
                    "title": "Spin degeneracy of the bands (2 for a model without spin, 1 with spin-orbit): the force on the atoms is summed over the spin channels"
                },
                "damping_time": {
                    "type": "number",
                    "default": 0.0,
                    "title": "Decay time of the amplitude of the lattice oscillations (phenomenological); 0 = no damping"
                },
                "damping_time_units": {
                    "type": "string",
                    "default": "fs",
                    "enum": [
                        "femtoseconds",
                        "fs",
                        "autime"
                    ],
                    "title": "Units of damping_time"
                },
                "coupling_scale": {
                    "type": "number",
                    "default": 1.0,
                    "title": "Factor multiplying the electron-phonon coupling of EPW (0 = lattice decoupled from the electrons)"
                },
                "acoustic_sum_rule": {
                    "type": "boolean",
                    "default": true,
                    "title": "Impose the acoustic sum rule on the force constants and remove the rigid translation from the electron-phonon coupling"
                },
                "adiabatic_reference": {
                    "type": "string",
                    "default": "static",
                    "enum": [
                        "static",
                        "dynamic"
                    ],
                    "title": "Adiabatic (Born-Oppenheimer) density matrix rho_BO(u): the force constants of ph.x already contain the static screening of the atoms by the electrons, so only rho - rho_BO pushes the atoms. static (recommended) = rho0 + static linear response of the electrons of the model to u, computed at the beginning (keeps the non-adiabatic correction Pi(omega) - Pi(0)); dynamic = density matrix propagated with the same displacements and no laser (removes also the non-adiabatic correction of the ground state)"
                },
                "initial_displacement": {
                    "type": "array",
                    "default": [],
                    "title": "Initial displacement of the atoms, 3 cartesian components per atom (lattice at rest); empty = equilibrium"
                },
                "initial_displacement_units": {
                    "type": "string",
                    "default": "angstrom",
                    "enum": [
                        "angstrom",
                        "nanometers",
                        "nm",
                        "aulength"
                    ],
                    "title": "Units of initial_displacement"
                }
            }
        },
        "kpath": {
            "type":  "array",
            "title": "vertex of a path in k space where we want to print the band structure",
            "minItems": 0,
            "maxItems": 100,
            "default": []
        },
        "lasers": {
            "type": "array",
            "title": "description of all the lasers",
            "minItems": 1,
            "maxItems": 10,
            "default" : {
                "type": "object",
                "title": "laser",
                "properties": 
                {
                    "intensity": {
                        "type": "number",
                        "default": 0.0,
                        "title": "Intensity of the laser"
                    },
                    "intensity_units": {
                        "type": "string",
                        "default": "wcm2",
                        "enum": [
                            "wcm2",
                            "auintensity"
                        ],
                        "title": "Units for intensity of the laser"
                    },
                    "frequency": {
                        "type": "number",
                        "default": 0.0,
                        "title": "Frequency of the laser"
                    },
                    "frequency_units": {
                        "type": "string",
                        "default": "electronvolt",
                        "enum": [
                            "electronvolt",
                            "joule",
                            "Rydberg",
                            "auenergy"
                        ],
                        "title": "Units for frequency of the laser"
                    },
                    "wavelength": {
                        "type": "number",
                        "default": 0.0,
                        "title": "Wavelength of the laser"
                    },
                    "wavelength_units": {
                        "type": "string",
                        "default": "nm",
                        "enum": [
                            "angstrom",
                            "nanometers",
                            "nm",
                            "aulength"
                        ],
                        "title": "Units for wavelength of the laser"
                    },
                    "polarization": {
                        "type": "array",
                        "items": {
                            "type": "number",
                            "default": 0.0
                        },
                        "title": "Polarization of the laser in cartesian coordinates"
                    },
                    "t0": {
                        "type": "number",
                        "default": 0.0,
                        "title": "initial time of the laser"
                    },
                    "t0_units": {
                        "type": "string",
                        "default": "fs",
                        "enum": [
                            "femtoseconds",
                            "fs",
                            "autime"
                        ],
                        "title": "Units for initial time of the laser"
                    },
                    "cycles": {
                        "type": "number",
                        "default": 0.0,
                        "title": "Number of cycles the sin2 laser last."
                    },
                    "phase": {
                        "type": "number",
                        "default": 0.0,
                        "title": "Phase of the laser"
                    }
                }
            }, 
            "items" : {
                "type": "object",
                "title": "laser",
                "properties": 
                {
                    "intensity": {
                        "type": "number",
                        "default": 0.0,
                        "title": "Intensity of the laser"
                    },
                    "intensity_units": {
                        "type": "string",
                        "default": "wcm2",
                        "enum": [
                            "wcm2",
                            "auintensity"
                        ],
                        "title": "Units for intensity of the laser"
                    },
                    "frequency": {
                        "type": "number",
                        "default": 0.0,
                        "title": "Frequency of the laser"
                    },
                    "frequency_units": {
                        "type": "string",
                        "default": "electronvolt",
                        "enum": [
                            "electronvolt",
                            "joule",
                            "Rydberg",
                            "auenergy"
                        ],
                        "title": "Units for frequency of the laser"
                    },
                    "wavelength": {
                        "type": "number",
                        "default": 0.0,
                        "title": "Wavelength of the laser"
                    },
                    "wavelength_units": {
                        "type": "string",
                        "default": "nm",
                        "enum": [
                            "angstrom",
                            "nanometers",
                            "nm",
                            "aulength"
                        ],
                        "title": "Units for wavelength of the laser"
                    },
                    "polarization": {
                        "type": "array",
                        "items": {
                            "type": "number",
                            "default": 0.0
                        },
                        "title": "Polarization of the laser in cartesian coordinates"
                    },
                    "t0": {
                        "type": "number",
                        "default": 0.0,
                        "title": "initial time of the laser"
                    },
                    "t0_units": {
                        "type": "string",
                        "default": "fs",
                        "enum": [
                            "femtoseconds",
                            "fs",
                            "autime"
                        ],
                        "title": "Units for initial time of the laser"
                    },
                    "cycles": {
                        "type": "number",
                        "default": 0.0,
                        "title": "Number of cycles the sin2 laser last."
                    },
                    "phase": {
                        "type": "number",
                        "default": 0.0,
                        "title": "Phase of the laser"
                    }
                }
            }
        }
    }
}
